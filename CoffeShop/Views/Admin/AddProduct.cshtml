@model CoffeShop.Models.Product
@{
    ViewData["Title"] = "Thêm Sản Phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Thêm Sản Phẩm Mới</h1>
    <a asp-action="Products" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left mr-1"></i> Quay Lại
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-plus-circle mr-1"></i> Thêm Sản Phẩm
                </h6>
            </div>
            <div class="card-body">
                <form asp-action="AddProduct" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label asp-for="Name" class="font-weight-bold">Tên Sản Phẩm</label>
                        <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Detail" class="font-weight-bold">Mô Tả</label>
                        <input asp-for="Detail" class="form-control" placeholder="Mô tả sản phẩm" />
                    </div>

                    <div class="form-group">
                        <label asp-for="ImageUrl" class="font-weight-bold">Image URL</label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Price" class="font-weight-bold">Giá (₫)</label>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Category" class="font-weight-bold">Danh Mục</label>
                                <input asp-for="Category" class="form-control" placeholder="Tea, Coffee, ..." />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Branch" class="font-weight-bold">Chi Nhánh</label>
                        <input asp-for="Branch" class="form-control" placeholder="Highland, Starbucks, ..." />
                    </div>

                    <div class="form-group form-check">
                        <input asp-for="IsTrendingProduct" class="form-check-input" type="checkbox" />
                        <label asp-for="IsTrendingProduct" class="form-check-label font-weight-bold">Trending Product</label>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary btn-sm mr-2">
                            <i class="fas fa-save mr-1"></i> Lưu
                        </button>
                        <a asp-action="Products" class="btn btn-secondary btn-sm">Hủy</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
