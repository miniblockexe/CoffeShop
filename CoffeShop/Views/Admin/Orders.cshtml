@model IEnumerable<CoffeShop.Models.Order>
@{
    ViewData["Title"] = "Orders";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Quản Lý Đơn Hàng</h1>
</div>

<div class="row">
    <div class="col-lg-12 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-shopping-cart mr-1"></i> Tất Cả Đơn Hàng
                </h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered" id="orderTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Thời Gian</th>
                                <th>Khách Hàng</th>
                                <th>Chi Tiết</th>
                                <th>Địa Chỉ</th>
                                <th class="text-right">Tổng Tiền</th>
                                <th class="text-center">Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int stt = 1;
                            }
                            @foreach (var order in Model)
                            {
                                <tr style="vertical-align: top;">
                                    <td class="pt-3">@stt</td>
                                    <td class="pt-3 text-nowrap">
                                        @order.OrderPlaced.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="pt-3">
                                        <div>@order.FirstName @order.LastName</div>
                                        <small class="text-muted">@order.Email</small>
                                    </td>
                                    <td>
                                        @if (order.OrderDetails != null)
                                        {
                                            @foreach (var d in order.OrderDetails)
                                            {
                                                <div class="d-flex align-items-center mb-1">
                                                    @if (d.Product?.ImageUrl != null)
                                                    {
                                                        <img src="@d.Product.ImageUrl" width="48" height="40"
                                                             alt="" class="rounded mr-2" />
                                                    }
                                                    <span style="font-size:0.83rem;">
                                                        @d.Quantity x @d.Product?.Name
                                                        <span class="text-muted">— @d.Price.ToString("0.00") ₫</span>
                                                    </span>
                                                </div>
                                            }
                                        }
                                    </td>
                                    <td class="pt-3">@order.Address</td>
                                    <td class="pt-3 text-right font-weight-bold">
                                        @order.OrderTotal.ToString("0.00") ₫
                                    </td>
                                    <td class="pt-3 text-center">
                                        <span class="badge badge-success">Success</span>
                                    </td>
                                </tr>
                                stt++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
