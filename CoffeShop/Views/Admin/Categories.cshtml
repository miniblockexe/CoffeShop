@model IEnumerable<CoffeShop.Models.Category>
@{
    ViewData["Title"] = "Quản Lý Danh Mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Quản Lý Danh Mục</h1>
</div>

<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-plus-circle mr-1"></i> Thêm Danh Mục Mới
                </h6>
            </div>
            <div class="card-body">
                <form asp-controller="Admin" asp-action="AddCategory" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label for="categoryName" class="font-weight-bold">Tên Danh Mục</label>
                        <input type="text"
                               class="form-control"
                               id="categoryName"
                               name="Name"
                               placeholder="Nhập tên danh mục..."
                               required />
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fas fa-save mr-1"></i> Lưu Danh Mục
                    </button>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-lg-8 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-tags mr-1"></i> Danh Sách Danh Mục
                </h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered" id="categoryTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Tên Danh Mục</th>
                                <th>Xóa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                int stt = 0;
                                foreach (var category in Model)
                                {
                                    <tr>
                                        <td>@stt</td>
                                        <td>@category.Name</td>
                                        <td>
                                            <form asp-controller="Admin" asp-action="DeleteCategory" method="post"
                                                  onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@category.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="fas fa-trash"></i> Xóa
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    stt++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted">
                                        <i class="fas fa-inbox mr-2"></i>Chưa có danh mục nào.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
