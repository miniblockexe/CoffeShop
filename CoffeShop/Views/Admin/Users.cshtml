@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityUser>
@{
    ViewData["Title"] = "Manage User";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Quản Lý Người Dùng</h1>
</div>

<div class="row">
    <div class="col-lg-12 mb-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-users mr-1"></i> Danh Sách User
                </h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered" id="userTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Confirmed</th>
                                <th>Xóa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int stt = 1;
                            }
                            @foreach (var user in Model)
                            {
                                var roles = userRoles != null && userRoles.ContainsKey(user.Id)
                                ? string.Join(", ", userRoles[user.Id])
                                : "User";
                                <tr>
                                    <td>@stt</td>
                                    <td>@user.Email</td>
                                    <td>
                                        <span class="badge badge-primary">
                                            @(string.IsNullOrEmpty(roles) ? "User" : roles)
                                        </span>
                                    </td>
                                    <td>
                                        @if (user.EmailConfirmed)
                                        {
                                            <span class="badge badge-success">Confirmed</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="DeleteUser" method="post"
                                              onsubmit="return confirm('Xóa user @user.Email?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="fas fa-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                stt++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
