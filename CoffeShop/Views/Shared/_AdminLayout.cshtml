@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>SB Admin - @ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fc;
            font-family: 'Nunito', sans-serif;
        }

        #sidebar {
            width: 220px;
            min-height: 100vh;
            background: linear-gradient(180deg, #4e73df 0%, #224abe 100%);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
        }

            #sidebar .sidebar-brand {
                padding: 16px 20px;
                color: #fff;
                font-size: 1rem;
                font-weight: 800;
                letter-spacing: 0.05rem;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 8px;
                border-bottom: 1px solid rgba(255,255,255,0.15);
            }

            #sidebar .sidebar-divider {
                border-top: 1px solid rgba(255,255,255,0.15);
                margin: 8px 16px;
            }

            #sidebar .sidebar-heading {
                padding: 6px 16px;
                color: rgba(255,255,255,0.4);
                font-size: 0.65rem;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 0.1rem;
            }

            #sidebar .nav-item .nav-link {
                color: rgba(255,255,255,0.8);
                padding: 10px 16px;
                font-size: 0.85rem;
                font-weight: 600;
                display: flex;
                align-items: center;
                gap: 10px;
                border-radius: 6px;
                margin: 2px 8px;
                transition: all 0.2s;
            }

                #sidebar .nav-item .nav-link:hover,
                #sidebar .nav-item .nav-link.active {
                    color: #fff;
                    background: rgba(255,255,255,0.15);
                }

            #sidebar .nav-link i {
                width: 16px;
                text-align: center;
            }

        #content-wrapper {
            margin-left: 220px;
            min-height: 100vh;
        }

        .topbar {
            height: 56px;
            background: #fff;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            position: sticky;
            top: 0;
            z-index: 99;
        }

            .topbar .topbar-search input {
                border-radius: 20px;
                border: 1px solid #d1d3e2;
                padding: 6px 16px;
                font-size: 0.85rem;
                width: 220px;
            }

            .topbar .user-info {
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 0.85rem;
                font-weight: 600;
                color: #5a5c69;
            }

            .topbar .user-avatar {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: #4e73df;
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.8rem;
                font-weight: 700;
            }

        .card {
            border: none;
            border-radius: 8px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.07);
        }

        .card-header {
            background: #fff;
            border-bottom: 1px solid #e3e6f0;
            font-weight: 700;
            font-size: 0.85rem;
            color: #4e73df;
        }

        .table th {
            font-size: 0.8rem;
            font-weight: 700;
            color: #5a5c69;
            text-transform: uppercase;
            border-top: none;
        }

        .table td {
            font-size: 0.87rem;
            vertical-align: middle;
        }

        .table img {
            border-radius: 4px;
            object-fit: cover;
        }

        .btn-sm {
            font-size: 0.78rem;
        }

        .btn-edit {
            color: #4e73df;
            background: none;
            border: none;
            font-weight: 600;
            padding: 0;
        }

            .btn-edit:hover {
                text-decoration: underline;
                color: #224abe;
            }

        .btn-delete {
            color: #e74a3b;
            background: none;
            border: none;
            font-weight: 600;
            padding: 0;
        }

            .btn-delete:hover {
                text-decoration: underline;
                color: #c0392b;
            }

        .alert {
            border-radius: 6px;
            font-size: 0.87rem;
        }

        .badge-success-soft {
            background: #e6f4ea;
            color: #1e7e34;
            border-radius: 20px;
            padding: 3px 10px;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .badge-role {
            background: #eaecf4;
            color: #4e73df;
            border-radius: 20px;
            padding: 3px 10px;
            font-size: 0.78rem;
            font-weight: 600;
        }
    </style>
</head>
<body>

    <div id="sidebar">
        <a class="sidebar-brand" asp-controller="Admin" asp-action="Index">
            <i class="fas fa-coffee"></i> SB ADMIN <sup style="font-size:0.6rem;">2</sup>
        </a>

        <ul class="nav flex-column mt-2">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Admin" asp-action="Index">
                    <i class="fas fa-tachometer-alt"></i> Dashboard
                </a>
            </li>

            <div class="sidebar-divider"></div>
            <div class="sidebar-heading">Manage Role & User</div>

            <li class="nav-item">
                <a class="nav-link" asp-controller="Admin" asp-action="ManageRole">
                    <i class="fas fa-user-shield"></i> Manage Role
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Admin" asp-action="Users">
                    <i class="fas fa-users"></i> Manage User
                </a>
            </li>

            <div class="sidebar-divider"></div>
            <div class="sidebar-heading">Manage</div>

            <li class="nav-item">
                <a class="nav-link" asp-controller="Admin" asp-action="Products">
                    <i class="fas fa-box"></i> Product
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Admin" asp-action="Orders">
                    <i class="fas fa-shopping-cart"></i> Order
                </a>
            </li>
        </ul>
    </div>

    <div id="content-wrapper">
        <div class="topbar">
            <div class="topbar-search">
                <input type="text" placeholder="Search for...">
                <button class="btn btn-primary btn-sm ms-2"><i class="fas fa-search"></i></button>
            </div>
            <div class="user-info">
                @if (SignInManager.IsSignedIn(User))
                {
                    <span>@UserManager.GetUserName(User)</span>
                }
                <div class="user-avatar">
                    <i class="fas fa-user"></i>
                </div>
            </div>
        </div>
            
        <div class="container-fluid p-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
